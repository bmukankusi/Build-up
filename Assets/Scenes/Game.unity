  m_Script: {fileID: 11500000, guid: c41cb3ddcfda3a346b43e506e71dc17b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyText: {fileID: 740446452}
  roomStories:
  - '"Emely and Anna enter the living room, excited for their weekend plans. They
    chat about school and upcoming projects."'
  - '"In the kitchen, they try new recipes. Emely is experimenting with baking, while
    Anna makes her favorite smoothie."'
  - '"After a long day, they relax in their cozy bedroom, chatting about life, dreams,
    and upcoming adventures."'
  - '"The bathroom is their mini spa. They enjoy their skincare routines, sharing
    beauty tips and self-care hacks."'
  - '"In the playground, they unwind, play games, and talk about their childhood
    memories."'
  - "\"Congratulations! You have followed Emely and Anna through their daily life.
    \U0001F389 Time to celebrate their journey!\""
